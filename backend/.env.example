# Copy this file to .env and adjust as needed.

# Port the HTTP server listens on.
PORT=3000

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=./data/shelter.sqlite

# Secret used to sign auth tokens. Change this to a long random string in production.
AUTH_SECRET=change-this-to-a-long-random-string

# Lifetime of an auth token, in seconds. 43200 = 12 hours.
AUTH_TOKEN_TTL_SECONDS=43200

# Comma-separated list of allowed origins for CORS, or * for any.
CORS_ORIGIN=*

# Used only by scripts/seed.js to create the first admin user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@example.com
